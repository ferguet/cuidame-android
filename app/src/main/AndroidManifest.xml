<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ENVIAR EL AVISO.
         Es el permiso delicado de esta app y hay que ser honesto con el:
         permite mandar SMS sin que nadie toque la pantalla. Es justo lo
         que hace falta, porque una persona inconsciente no puede pulsar
         "enviar". Solo se usa en dos sitios de todo el codigo: el aviso
         de emergencia y el boton de prueba. Nunca en segundo plano por
         su cuenta. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- LEER LOS MENSAJES QUE LLEGAN, y solo para una cosa: ver si el
         contacto guardado esta preguntando "donde". Los mensajes de
         cualquier otro numero se descartan sin mirarlos, no se guardan y
         no salen del movil. Hace falta porque una persona con demencia no
         va a pedir ayuda: hay que poder preguntarle al movil. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Para poder decir DONDE esta la persona en el mensaje. Sin esto el
         aviso sirve de poco: "se ha caido" sin decir donde no ayuda. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Vigilar los sensores con la pantalla apagada. Android obliga a que
         esto sea un servicio "en primer plano" con aviso visible, y me
         parece bien: la persona tiene que ver siempre que la app esta
         mirando. Nada de vigilancia escondida. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Para el modo coche: leer la velocidad del GPS mientras el servicio
         vigila. Con el servicio en primer plano y este tipo declarado, no
         hace falta el permiso de "ubicacion en segundo plano", que es el
         que Android pone mas dificil y con razon. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- LA CLAVE PARA QUE AVISE CON EL MOVIL BLOQUEADO.
         Desde Android 10 una app no puede abrir una pantalla estando en
         segundo plano: el sistema la guarda y la enseña al desbloquear.
         Este permiso es el que usan los despertadores y las llamadas
         entrantes para saltarse esa regla de forma legitima. Sin el, la
         app no avisaba hasta que alguien desbloqueaba el movil, que es
         justo cuando ya no hace falta. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Que la vigilancia vuelva sola si se reinicia el movil. Un movil que
         se apaga por la noche y amanece sin vigilar es una trampa. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Solo para medir el pulso apoyando el dedo en la lente. La imagen
         nunca se enseña, no se graba y no sale del movil: de cada foto se
         saca un unico numero -el brillo medio- y se tira al instante. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- LEER LO QUE LA PULSERA DEJA EN HEALTH CONNECT.
         Solo lectura y solo estas tres cosas. No se escribe nada, no se
         pide nada mas, y todo se queda en el movil. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:label="Cuídame"
        android:icon="@android:drawable/ic_menu_myplaces"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La alarma tiene que salir SI O SI, aunque el movil este
             bloqueado en el bolsillo y con la pantalla apagada. De ahi
             showOnLockScreen y turnScreenOn. Y excludeFromRecents para
             que no se quede dando vueltas en las apps recientes. -->
        <activity
            android:name=".AlarmaActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <!-- Pantalla de taller: enseña lo que miden los sensores en vivo.
             Sin esto, cuando la deteccion no salta no hay forma de saber
             por que, y ajustar los umbrales a ciegas es perder el tiempo. -->
        <activity
            android:name=".DiagnosticoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PulsoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".RespiracionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".FotoOjoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".TemblorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Android obliga a que la app pueda explicar POR QUE pide datos
             de salud, y con razon: son los datos mas delicados que hay. -->
        <activity
            android:name=".PulseraActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PulseraActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".EquilibrioActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".HistorialActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".ServicioVigilancia"
            android:exported="false"
            android:foregroundServiceType="health|location" />

        <!-- Contesta al "¿dónde está?" del contacto. Se enciende, coge la
             posición, manda el mensaje y se apaga: no queda nada corriendo. -->
        <service
            android:name=".ServicioConsulta"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".ReceptorSms"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ArranqueReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
